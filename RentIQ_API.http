--WebAppBoundary
Content-Disposition: form-data; name="data"

{"nationalIdNumber": "123456789", "nationalIdType": "NATIONAL_ID", "nationalIdCountry": "KHM"}
--WebAppBoundary
Content-Disposition: form-data; name="frontImage"; filename=""

< 
--WebAppBoundary
Content-Disposition: form-data; name="backImage"; filename=""

< 
--WebAppBoundary

