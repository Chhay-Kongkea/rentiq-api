# RentIQ API

###
# group: Auth
# @name Register
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
    "username": "johndoe",
    "password": "Password123!",
    "confirmPassword": "Password123!",
    "email": "johndoe@example.com",
    "firstName": "John",
    "lastName": "Doe"
}

###
# group: Auth
# @name Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
    "username": "johndoe",
    "password": "Password123!"
}

###
# group: Auth
# @name Logout
POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "refreshToken": "{{refreshToken}}"
}

###
# group: Auth
# @name Refresh Token
POST {{baseUrl}}/api/v1/auth/refresh-token
Content-Type: application/json

{
    "refreshToken": "{{refreshToken}}"
}

###
# group: Auth
# @name Forgot Password
POST {{baseUrl}}/api/v1/auth/forgot-password
Content-Type: application/json

{
    "email": "johndoe@example.com"
}

###
# group: Auth
# @name Verify Email Status
GET {{baseUrl}}/api/v1/auth/verify-email?
    email=johndoe@example.com

###
# group: Auth
# @name Resend Verification Email
POST {{baseUrl}}/api/v1/auth/resend-verification-email
Content-Type: application/json

{
    "email": "johndoe@example.com"
}

###
# group: Auth
# @name Change Password
POST {{baseUrl}}/api/v1/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "currentPassword": "Password123!",
    "newPassword": "NewPassword123!",
    "confirmPassword": "NewPassword123!"
}

###
# group: User Profile
# @name Get My Profile
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer {{accessToken}}

###
# group: User Profile
# @name Update My Profile
PATCH {{baseUrl}}/api/v1/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "locale": "en-US"
}

###
# group: User Profile
# @name Get Public Profile
# Path variable :id = target user's ID
GET {{baseUrl}}/api/v1/users/{{id}}
Authorization: Bearer {{accessToken}}

###
# group: User Profile
# @name Upload Avatar
POST {{baseUrl}}/api/v1/users/me/avatar
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename=""

< 
--WebAppBoundary

###
# group: User Profile
# @name Delete Avatar
DELETE {{baseUrl}}/api/v1/users/me/avatar
Authorization: Bearer {{accessToken}}

###
# group: User Profile
# @name List Addresses
GET {{baseUrl}}/api/v1/users/me/addresses
Authorization: Bearer {{accessToken}}

###
# group: User Profile
# @name Add Address
POST {{baseUrl}}/api/v1/users/me/addresses
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "addressLine": "123 Main St",
    "city": "Phnom Penh",
    "country": "KHM",
    "latitude": 11.5564,
    "longitude": 104.9282,
    "isDefault": true
}

###
# group: User Profile
# @name Get Address
GET {{baseUrl}}/api/v1/users/me/addresses/{{addressId}}
Authorization: Bearer {{accessToken}}

###
# group: User Profile
# @name Update Address
PATCH {{baseUrl}}/api/v1/users/me/addresses/{{addressId_1}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "addressLine": "456 New St",
    "city": "Phnom Penh",
    "country": "KHM",
    "latitude": 11.5564,
    "longitude": 104.9282,
    "isDefault": false
}

###
# group: User Profile
# @name Delete Address
DELETE {{baseUrl}}/api/v1/users/me/addresses/{{addressId_2}}
Authorization: Bearer {{accessToken}}

###
# group: User Profile
# @name Set Default Address
PATCH {{baseUrl}}/api/v1/users/me/addresses/{{addressId_3}}/default
Authorization: Bearer {{accessToken}}

###
# group: User Profile
# @name Get Notification Preferences
GET {{baseUrl}}/api/v1/users/me/notification-preferences
Authorization: Bearer {{accessToken}}

###
# group: User Profile
# @name Update Notification Preferences
PATCH {{baseUrl}}/api/v1/users/me/notification-preferences
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "bookingNotifications": true,
    "paymentNotifications": true,
    "marketingNotifications": false,
    "emailNotifications": true,
    "pushNotifications": true
}

###
# group: KYC
# @name Submit KYC
POST {{baseUrl}}/api/v1/kyc
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="data"

{"nationalIdNumber": "123456789", "nationalIdType": "NATIONAL_ID", "nationalIdCountry": "KHM"}
--WebAppBoundary
Content-Disposition: form-data; name="frontImage"; filename=""

< 
--WebAppBoundary
Content-Disposition: form-data; name="backImage"; filename=""

< 
--WebAppBoundary

