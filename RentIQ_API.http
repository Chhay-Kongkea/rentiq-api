###
# group: Items
# @name List Public Items
GET {{baseUrl}}/api/v1/items?
    keyword=&
    minPrice=&
    maxPrice=&
    categoryId=&
    condition=GOOD&
    available=true&
    featured=&
    location=&
    pageNumber=0&
    pageSize=12&
    sortBy=createdAt&
    sortDirection=desc
Authorization: Bearer {{accessToken}}

###
# group: Items
# @name Get Item By Id
GET {{baseUrl}}/api/v1/items/{{itemId}}
Authorization: Bearer {{accessToken}}

###
# group: Items
# @name Create Item
POST {{baseUrl}}/api/v1/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "categoryId": 1,
    "title": "Canon EOS R5 Camera",
    "description": "Professional mirrorless camera in excellent condition",
    "condition": "LIKE_NEW",
    "specifications": {
        "brand": "Canon",
        "model": "EOS R5"
    },
    "locationText": "Phnom Penh, Cambodia",
    "latitude": 11.5564,
    "longitude": 104.9282,
    "pricePerDay": 25.0,
    "depositAmount": 200.0
}

