# ==========================================================
# DEPLOYED DATABASE ON OVH
# ==========================================================

DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=rentiq_db
DB_PORT=5434

# Your local Spring Boot connects through OVH public IP
DB_URL=jdbc:postgresql://15.235.202.244:5434/rentiq_db


# ==========================================================
# DEPLOYED KEYCLOAK
# ==========================================================

SERVER_URL=https://auth.rentiq.com
ISSUER_URI=https://auth.rentiq.com/realms/rentiq-app

CLIENT_ID=rentiq-client
CLIENT_SECRET=YOUR_CLIENT_SECRET

REALM=master
TARGET_REALM=rentiq-app


# ==========================================================
# LOCAL FRONTEND
# ==========================================================

FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false


# ==========================================================
# LOCAL SPRING
# ==========================================================

PORT=8282
SPRING_PROFILES_ACTIVE=dev


# ==========================================================
# CLOUDINARY
# ==========================================================

CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET